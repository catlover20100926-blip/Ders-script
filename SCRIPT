		local b_corner = Instance.new("UICorner")
		b_corner.CornerRadius = UDim.new(0, 8)
		b_corner.Parent = btn

		local function activate()
			for _, p in pairs(pages) do
				p.Visible = false
			end
			page.Visible = true

			for _, b in ipairs(sidebar:GetChildren()) do
				if b:IsA("TextButton") then
					b.BackgroundColor3 = Color3.fromRGB(36, 28, 52)
					b.BackgroundTransparency = 0.5
					b.TextColor3 = THEME.text_dim
				end
			end
			btn.BackgroundColor3 = THEME.primary
			btn.BackgroundTransparency = 0
			btn.TextColor3 = Color3.new(1, 1, 1)
			_current_page = tab_id
		end

		btn.MouseButton1Click:Connect(activate)
		nav_buttons[tab_id] = activate

		-- Render all cards and fields inside this tab (if in MODULE_SECTIONS)
		local tab_cards = MODULE_SECTIONS[tab_id]
		if tab_cards then
			for _, card_spec in ipairs(tab_cards) do
				local card_content, _ = create_card(page, card_spec.title, card_spec.note)
				for _, f in ipairs(card_spec.fields) do
					local fpath = f[1]
					local flabel = f[2]
					local ftype = f[3]
					local fopts = f[4]
					local fstep = f[5]

					if ftype == "boolean" then
						render_bool_field(card_content, fpath, flabel)
					elseif ftype == "number" then
						render_number_field(card_content, fpath, flabel, fstep)
					elseif ftype == "select" then
						render_select_field(card_content, fpath, flabel, fopts)
					elseif ftype == "text" then
						render_text_field(card_content, fpath, flabel)
					elseif ftype == "color" then
						render_color_field(card_content, fpath, flabel)
					end
				end
			end
		end
	end

