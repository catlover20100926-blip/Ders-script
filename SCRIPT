	local function load_menu_key()
		local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
		local isf = genv.isfile or isfile
		local rf = genv.readfile or readfile
		if type(isf) == "function" and isf("absolve/menu_key.txt") and type(rf) == "function" then
			local raw: any = nil
			pcall(function() raw = rf("absolve/menu_key.txt") end)
			if raw and type(raw) == "string" and #raw > 0 then
				raw = string.gsub(raw, "%s+", "")
				local ok, kc = pcall(function()
					return (Enum.KeyCode :: any)[raw]
				end)
				if ok and kc and kc ~= Enum.KeyCode.Unknown then
					return kc
				end
			end
		end
		return nil
	end

