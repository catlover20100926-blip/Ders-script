local function find_tool(container, name)
	if not container or not name then
		return nil
	end
	local direct = container:FindFirstChild(name)
	if direct and direct:IsA("Tool") then
		return direct
	end
	local clean_target = string.lower((string.gsub(name, "[%[%]%s_%-]", "")))
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") then
			local clean_child = string.lower((string.gsub(child.Name, "[%[%]%s_%-]", "")))
			if clean_child == clean_target or string.find(clean_child, clean_target, 1, true) or string.find(clean_target, clean_child, 1, true) then
				return child
			end
		end
	end
	return nil
end

-- equip a tool by name (Character first, then Backpack); returns true when
-- the named tool is (or becomes) the equipped tool
local function equip_tool_by_name(name)
	local char = client.Character
	if not char then
		return false
	end
	local held = held_tool
	if held and (held.Name == name or find_tool(char, name) == held) then
		return true
	end
	local bp = current_backpack()
	local tool = find_tool(bp, name) or find_tool(char, name)
	if not tool then
		return false
	end
	local hum = refs_for(client).humanoid
	if not hum then
		return false
	end
	if not pcall(hum.EquipTool, hum, tool) then
		pcall(function()
			tool.Parent = char
		end)
	end
	return true
end

-- ammo check by tool name: reads the event-driven cache (Ammo.Changed keeps
-- it fresh; container ChildAdded/ChildRemoved add/remove entries). unknown
-- tool counts as loaded: a gun outside the cache (never watched, spawned
-- later, renamed) must not silently disable the macro -- the worst case is
-- one wasted click on an empty gun, not a dead macro.
local function tool_named_has_ammo(name)
	if not name then
		return true
	end
	local clean_target = string.lower((string.gsub(name, "[%[%]%s_%-]", "")))
	local found = false
	for tool, loaded in pairs(tool_ammo) do
		if tool.Parent ~= nil then
			local clean_tool = string.lower((string.gsub(tool.Name, "[%[%]%s_%-]", "")))
			if clean_tool == clean_target or string.find(clean_tool, clean_target, 1, true) then
				found = true
				if loaded then
					return true
				end
			end
		end
	end
	-- Unknown tools keep the old fail-open behavior: one harmless click is
	-- preferable to permanently disabling a gun that appeared late.
	return not found
end

-- true when BOTH gun-macro guns are out of ammo (can't complete a
-- full cycle with neither, so fall back to plain triggerbot). when only
-- ONE is empty the cycle still runs -- the swap phases skip the empty gun
-- instead of killing the whole macro.
local function both_gun_empty(gm_cfg)
	return not tool_named_has_ammo(gm_cfg.primary) and not tool_named_has_ammo(gm_cfg.secondary)
end

-- true when the named tool is the equipped tool. Event cache first, then
-- direct Character inspection if stale, with flexible bracket/case matching.
local function held_is(name)
	if not name then
		return false
	end
	if held_tool_name == name then
		return true
	end
	local char = client.Character
	if char then
		local current = char:FindFirstChildOfClass("Tool")
		if current then
			if current ~= held_tool then
				set_held_tool(current)
			end
			if current.Name == name then
				return true
			end
			local clean_target = string.lower((string.gsub(name, "[%[%]%s_%-]", "")))
			local clean_current = string.lower((string.gsub(current.Name, "[%[%]%s_%-]", "")))
			return clean_current == clean_target or string.find(clean_current, clean_target, 1, true) ~= nil
		end
	end
	return false
end

local function find_gun_cfg(gun_name)
	if not gun_name then
		return nil
	end
	local tb = cfg() and cfg().triggerbot
	local guns = tb and tb.guns
	if not guns then
		return nil
	end
	if guns[gun_name] then
		return guns[gun_name]
	end
	local clean_target = string.lower((string.gsub(gun_name, "[%[%]%s_%-]", "")))
	for name, gcfg in pairs(guns) do
		local clean_name = string.lower((string.gsub(name, "[%[%]%s_%-]", "")))
		if clean_name == clean_target or string.find(clean_name, clean_target, 1, true) then
			return gcfg
		end
	end
	return nil
end

-- gun-macro fov radius in pixels, or nil when the fov is disabled. the
-- macro passes this to triggerbot_target so swaps and shots only happen
-- when a target's root is inside the circle around the crosshair. the
-- plain triggerbot never passes it, so it keeps firing across the whole
-- screen.
local function gm_fov_radius(gm_cfg)
	local fov = gm_cfg and gm_cfg.fov
	if fov and fov.enabled ~= false and type(fov.radius) == "number" then
		return fov.radius
	end
	return nil
end

-- fire gate for a shoot phase. debug bypasses everything. otherwise it
-- follows the triggerbot checks for the CURRENT gun: the gun must be a
-- registered triggerbot gun, actually held (so we never fire the wrong
-- tool), and a target must be under the crosshair within that gun's range
-- (range, k.o and LOS are baked into the scan), plus the gun-macro's
-- own k.o and ammo checks.
--
-- the target gate uses the same movement-aware grace as the plain
-- triggerbot (exit_buffer + speed bonus): the scan rect only refreshes at
-- ~60Hz while this runs at ~240Hz, so a fast target that leaves the rect
-- for a single frame must not kill the burst. a confirmed target extends
-- the deadline; a miss only breaks the gate once the deadline expires.
local function gun_macro_ok(gm_cfg, gun_name, now)
	if gm_cfg.debug then
		return true
	end
	local checks = gm_cfg.checks
	if checks.ko and is_ko(client) then
		return false
	end
	if checks.crouched ~= false and self_crouched() then
		return false
	end
	if checks.ammo and not tool_named_has_ammo(gun_name) then
		return false
	end
	if not held_is(gun_name) then
		return false
	end
	-- triggerbot gate: registered gun, optionally with a target under the
	-- crosshair (target-check). the registered-gun part always applies so we
	-- never fire an unregistered tool through the macro.
	local gun_cfg = find_gun_cfg(gun_name)
	if gun_cfg == nil then
		return false
	end
	if checks.target ~= false then
		local t = triggerbot_target(gun_cfg, gm_fov_radius(gm_cfg))
		if t then
			local base = gun_cfg.exit_buffer
			if not (type(base) == "number" and base > 0) then
				base = cfg().triggerbot.timing.exit_buffer
			end
			local speed_factor = cfg().triggerbot.timing.speed_factor or 0.0025
			local speed_bonus = clamp((root_speed(t) + root_speed(client)) * speed_factor, 0, 0.3)
			gun_macro_state.target_deadline = now + base + speed_bonus
			gun_macro_state.last_target_at = now
		elseif now >= gun_macro_state.target_deadline then
			return false
		end
	else
		-- target gate off: fire window always open, phase machine advances
		-- on pure schedule
		gun_macro_state.target_deadline = huge
	end
	return true
end

-- true when ANY enemy is within the named gun's range (crosshair not
-- required). used to arm the swap phases the moment combat is possible, so
-- the gun is ready before the crosshair lands on someone. distances are
-- measured from the CHARACTER root, not the camera: in third person the
-- camera hangs far behind the player, and a camera-based check would keep
-- arming/swapping for enemies that are well out of gun range.
local function gun_in_range(gm_cfg, gun_name)
	if gm_cfg.debug then
		return true
	end
	local gun_cfg = find_gun_cfg(gun_name)
	if not gun_cfg or type(gun_cfg.range) ~= "number" then
		return false
	end
	local team_check = not (gm_cfg.checks and gm_cfg.checks.team == false)
	local ko_check = (gm_cfg.checks and gm_cfg.checks.ko) == true
	return nearest_enemy_distance2(team_check, clock(), ko_check) <= gun_cfg.range * gun_cfg.range
end

-- true when the named macro gun is loaded AND has an enemy in range.
-- range alone isn't enough to arm a phase: arming an empty gun would
-- stall the cycle on a wasted equip. kept below gun_in_range so the
-- reference binds lexically.
local function gun_loaded_in_range(gm_cfg, gun_name)
	return tool_named_has_ammo(gun_name) and gun_in_range(gm_cfg, gun_name)
end

-- true when the named macro gun is loaded AND a target is confirmed.
-- If target check is disabled or debug is enabled, arms freely as long as loaded.
local function aimed_gun(gm_cfg, gun_name)
	if not tool_named_has_ammo(gun_name) then
		return false
	end
	if gm_cfg.debug or (gm_cfg.checks and gm_cfg.checks.target == false) then
		return true
	end
	local gun_cfg = find_gun_cfg(gun_name)
	return triggerbot_target(gun_cfg, gm_fov_radius(gm_cfg)) ~= nil
end

-- auto-gun-macro: true when the triggerbot mode is gun-macro, the gun-macro
-- is enabled, at least one macro gun is loaded (not both empty), the
-- triggerbot key is held, and some enemy is within the macro guns' max
-- range. the triggerbot scan stays active for the range/LOS data the macro
-- needs. the plain target-under-crosshair gate still applies inside the
-- macro, so this only arms it, never forces a shot.
local function gun_macro_auto_active(gm_cfg)
	local triggerbot = cfg().triggerbot
	if not triggerbot.enabled or triggerbot.mode ~= "gun-macro" then
		return false
	end
	if not is_trigger_active() then
		return false
	end
	if not (gm_cfg and gm_cfg.enabled) then
		return false
	end
	if gm_cfg.checks.ko and is_ko(client) then
		return false
	end
	if both_gun_empty(gm_cfg) then
		return false
	end
	-- character-based distance, same reason as gun_in_range: the camera
	-- floats behind the player, so camera-based arming would keep the
	-- macro armed for enemies that are far from the character
	local primary = triggerbot.guns[gm_cfg.primary]
	local secondary = triggerbot.guns[gm_cfg.secondary]
	local primary_range = primary and type(primary.range) == "number" and primary.range or 0
	local secondary_range = secondary and type(secondary.range) == "number" and secondary.range or 0
	local best_range = primary_range > secondary_range and primary_range or secondary_range
	if best_range <= 0 then
		return false
	end
	local team_check = not (triggerbot.checks and triggerbot.checks.team == false)
	local ko_check = (gm_cfg.checks and gm_cfg.checks.ko) == true
	return nearest_enemy_distance2(team_check, clock(), ko_check) <= best_range * best_range
end

-- auto-swap state: pending equip + retry deadline for the auto-swap below
local auto_swap_state = { pending = nil, swap_at = 0, retry_at = 0 }

-- auto-swap: mutually exclusive with mode = "gun-macro". while the trigger key
-- is held, pick the registered gun whose distance best fits the nearest
-- target (shotgun up close, revolver at range) and keep it equipped.
-- no cycling/phase machine — the plain triggerbot firing path then does
-- the shooting, so this only ever issues an equip when the best fit
-- changes, with a 1s retry if the equip didn't land.
local function auto_swap_tick(now)
	local triggerbot = cfg().triggerbot
	local active = triggerbot.enabled
		and triggerbot.mode == "auto-swap"
		and is_trigger_active()
		and not (triggerbot.checks.ko and is_ko(client))
	if not active then
		-- dropping the bind cancels a swap still counting down, so a stale
		-- decision can never equip on the next press
		auto_swap_state.pending = nil
		return
	end

	local team_check = triggerbot.checks.team ~= false
	local ko_check = (triggerbot.checks and triggerbot.checks.ko) == true
	local target_dist2 = nearest_enemy_distance2(team_check, now, ko_check)
	if target_dist2 == huge then
		auto_swap_state.pending = nil
		return
	end

	-- closest-fit gun: smallest registered distance that still covers the
	-- target, with ammo; on range ties prefer the gun-macro primary
	-- (e.g. the double-barrel) over the secondary, then the currently
	-- held gun so we don't churn between two shotguns with the same range
	local gm_cfg2 = cfg().triggerbot.gun_macro
	local primary_gun = gm_cfg2 and gm_cfg2.primary
	local best, best_dist = nil, huge
	for name, gun_cfg in pairs(triggerbot.guns) do
		local d = gun_cfg and gun_cfg.range
		if type(d) == "number" and d * d >= target_dist2 and tool_named_has_ammo(name) then
			if d < best_dist then
				best, best_dist = name, d
			elseif d == best_dist then
				local name_is_primary = name == primary_gun
				local best_is_primary = best == primary_gun
				if name_is_primary and not best_is_primary then
					best = name
				elseif not name_is_primary and not best_is_primary and name == held_tool_name and best ~= held_tool_name then
					best = name
				end
			end
		end
	end
	if not best or best == held_tool_name then
		auto_swap_state.pending = nil
		return
	end

	-- swap delay (triggerbot.timing.swap, seconds): a fresh decision starts
	-- a countdown instead of equipping immediately. if the best fit changes
	-- before it elapses (target strafing across a range boundary) the
	-- countdown restarts for the new choice, so boundary flicker can never
	-- churn equips. once it elapses the equip re-issues at 0.05s intervals
	-- until it lands. 0 = instant (legacy behavior).
	local swap_delay = tonumber(triggerbot.timing and triggerbot.timing.swap) or 0
	if held_tool_name == nil then
		-- bare hands: there is no gun to switch away from, so the delay
		-- does not apply -- arming up stays instant even with a long
		-- delay configured. clearing pending also restarts any countdown
		-- that was running while a gun was still equipped.
		auto_swap_state.pending = nil
		swap_delay = 0
	end
	if best ~= auto_swap_state.pending then
		auto_swap_state.pending = best
		auto_swap_state.swap_at = now + math.max(swap_delay, 0)
	end
	if now < auto_swap_state.swap_at then
		return
	end

	if now >= auto_swap_state.retry_at then
		equip_tool_by_name(best)
		auto_swap_state.retry_at = now + 0.05
	end
end

-- state machine tick; phases:
-- swap1 -> shoot1 -> swap2 -> shoot2 -> cooldown
local function gun_macro_tick(now, gm_cfg)
	local timing = gm_cfg.timing or {}
	local timing_swap = tonumber(timing.swap) or 0
	local timing_shoot = tonumber(timing.shoot_duration) or 0
	local timing_cycle = tonumber(timing.cycle) or 0.3
	local click_interval = tonumber(cfg().triggerbot and cfg().triggerbot.timing and cfg().triggerbot.timing.click_interval) or 0.015
	local phase = gun_macro_state.phase

	-- debug: periodic state dump
	if gm_cfg.debug and now >= (gun_macro_state.debug_next_log or 0) then
		gun_macro_state.debug_next_log = now + 0.5
		print(string.format(
			"[absolve:gm] phase=%s ready_in=%.2f target_grace=%.2f | timing swap=%g shoot=%g cycle=%g",
			tostring(phase),
			math.max(gun_macro_state.ready_at - now, 0),
			math.max(gun_macro_state.target_deadline - now, 0),
			timing_swap,
			timing_shoot,
			timing_cycle
		))
	end

	-- MacroX hook: hold macro during game's own macro
	if macro_x_active() then
		return
	end

	-- K.O.'d: freeze macro while downed
	if gm_cfg.checks and gm_cfg.checks.ko and is_ko(client) then
		return
	end

	-- BOTH gun-macro guns empty: fall back to single trigger firing
	if both_gun_empty(gm_cfg) then
		if not gm_cfg.debug then
			local triggerbot = cfg().triggerbot
			if not triggerbot.enabled then
				return
			end
			local gun_cfg, is_knife = equipped_tool_state(triggerbot)
			if gun_cfg == nil then
				return
			end
			if triggerbot.checks and triggerbot.checks.knife and is_knife then
				return
			end
			if triggerbot.checks and triggerbot.checks.crouched ~= false and self_crouched() then
				return
			end
			if triggerbot_target(gun_cfg) == nil then
				return
			end
		end
		if now - tb_state.last_click >= click_interval then
			activate_tool()
			tb_state.last_click = now
		end
		return
	end

	-- park: revert to home gun if no loaded gun is within range
	if not gun_loaded_in_range(gm_cfg, gm_cfg.primary) and not gun_loaded_in_range(gm_cfg, gm_cfg.secondary) then
		local home = gun_macro_state.home_gun
		local held_name = held_tool_name
		local held_macro_gun = held_name == gm_cfg.primary or held_name == gm_cfg.secondary
		if home and held_macro_gun and not held_is(home) and now >= gun_macro_state.swap_deadline then
			equip_tool_by_name(home)
			gun_macro_state.swap_deadline = now + 0.25
		end
		gun_macro_state.phase = "swap1"
		gun_macro_state.ready_at = now + timing_cycle
		return
	end

	if phase == "swap1" then
		-- Consume swap delay from cooldown before arming/firing primary
		if now < gun_macro_state.ready_at then
			return
		end
		if aimed_gun(gm_cfg, gm_cfg.primary) then
			if held_is(gm_cfg.primary) then
				gun_macro_state.ready_at = now + timing_shoot
				gun_macro_state.phase = "shoot1"
			elseif now >= gun_macro_state.swap_deadline then
				-- Rate-limit EquipTool calls to avoid freezing tool equip animation
				if not equip_tool_by_name(gm_cfg.primary) then
					gun_macro_state.ready_at = now + timing_swap
					gun_macro_state.swap_deadline = now + 0.25
					gun_macro_state.phase = "swap2"
				else
					gun_macro_state.swap_deadline = now + 0.1
				end
			end
		elseif aimed_gun(gm_cfg, gm_cfg.secondary) then
			gun_macro_state.ready_at = now + timing_swap
			gun_macro_state.swap_deadline = now + 0.25
			gun_macro_state.phase = "swap2"
		end
	elseif phase == "shoot1" then
		if not held_is(gm_cfg.primary) then
			gun_macro_state.ready_at = now + timing_swap
			gun_macro_state.swap_deadline = now + 0.25
			gun_macro_state.phase = "swap1"
		else
			local ok = gun_macro_ok(gm_cfg, gm_cfg.primary, now)
			if ok and now - tb_state.last_click >= click_interval then
				activate_tool()
				tb_state.last_click = now
			end
			if (gm_cfg.checks and gm_cfg.checks.target == false) or gm_cfg.debug or gun_macro_state.target_deadline > now then
				if now >= gun_macro_state.ready_at then
					gun_macro_state.ready_at = now + timing_swap
					gun_macro_state.swap_deadline = now + 0.25
					gun_macro_state.phase = "swap2"
				end
			elseif now - gun_macro_state.last_target_at >= timing_cycle then
				gun_macro_state.ready_at = now + timing_cycle
				gun_macro_state.phase = "swap1"
			end
		end
	elseif phase == "swap2" then
		if now < gun_macro_state.ready_at then
			return
		end
		if aimed_gun(gm_cfg, gm_cfg.secondary) then
			if held_is(gm_cfg.secondary) then
				gun_macro_state.ready_at = now + timing_shoot
				gun_macro_state.phase = "shoot2"
			elseif now >= gun_macro_state.swap_deadline then
				if not equip_tool_by_name(gm_cfg.secondary) then
					gun_macro_state.ready_at = now + timing_cycle
					gun_macro_state.swap_deadline = now + 0.25
					gun_macro_state.phase = "cooldown"
				else
					gun_macro_state.swap_deadline = now + 0.1
				end
			end
		elseif aimed_gun(gm_cfg, gm_cfg.primary) then
			gun_macro_state.ready_at = now + timing_cycle
			gun_macro_state.swap_deadline = now + 0.25
			gun_macro_state.phase = "cooldown"
		elseif now - gun_macro_state.last_target_at >= timing_cycle then
			gun_macro_state.ready_at = now + timing_cycle
			gun_macro_state.phase = "swap1"
		end
	elseif phase == "shoot2" then
		if not held_is(gm_cfg.secondary) then
			gun_macro_state.ready_at = now + timing_swap
			gun_macro_state.swap_deadline = now + 0.25
			gun_macro_state.phase = "swap2"
		else
			local ok = gun_macro_ok(gm_cfg, gm_cfg.secondary, now)
			if ok and now - tb_state.last_click >= click_interval then
				activate_tool()
				tb_state.last_click = now
			end
			if (gm_cfg.checks and gm_cfg.checks.target == false) or gm_cfg.debug or gun_macro_state.target_deadline > now then
				if now >= gun_macro_state.ready_at then
					gun_macro_state.ready_at = now + timing_cycle
					gun_macro_state.swap_deadline = now + 0.25
					gun_macro_state.phase = "cooldown"
				end
			elseif now - gun_macro_state.last_target_at >= timing_cycle then
				gun_macro_state.ready_at = now + timing_cycle
				gun_macro_state.phase = "swap1"
			end
		end
	elseif phase == "cooldown" then
		if now >= gun_macro_state.ready_at then
			gun_macro_state.ready_at = now + timing_swap
			gun_macro_state.swap_deadline = now + 0.25
			gun_macro_state.phase = "swap1"
		end
	end
end
-- A live config commit invalidates every dependent phase in one place.
-- Physical key state remains in keys_down, so hold-mode binds immediately
-- follow the new key without inheriting a stale boolean from the old bind.
reset_runtime_state = function()
	toggle_on = false
	aim_toggle_on = false
	crouch_held = keys_down[Enum.KeyCode.LeftControl] == true or keys_down[Enum.KeyCode.RightControl] == true
	tb_state.active = false
	tb_state.exit_deadline = 0
	tb_state.last_click = 0
	render_target = nil
	gun_macro_state.active = false
	gun_macro_state.manual = false
	gun_macro_state.auto = false
	gun_macro_state.phase = "swap1"
	gun_macro_state.ready_at = 0
	gun_macro_state.swap_deadline = 0
	gun_macro_state.home_gun = nil
	gun_macro_state.target_deadline = 0
	gun_macro_state.last_target_at = 0
	auto_swap_state.pending = nil
	auto_swap_state.retry_at = 0
	auto_swap_state.swap_at = 0
	gm_scan_active = false
	last_gun_distance = nil
	proximity_refresh_at = 0
	carry_x, carry_y = 0, 0
	last_move_time = clock()
	invalidate_scan()
end

-- central input handler: all keybinds (trigger, aim, macro-x,
-- gun-macro) in one pair so key state stays consistent
connect(uis.InputBegan, function(input, GameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local code = input.KeyCode
	if GameProcessed then
		-- chat/GUI consumed the press: never arm hold-binds from it, and
		-- release any stale entry so typing can't leave a bind stuck down
		keys_down[code] = nil
		return
	end
	keys_down[code] = true
	if code == Enum.KeyCode.LeftControl or code == Enum.KeyCode.RightControl then
		crouch_held = true
	end
	if code == keycode(cfg().triggerbot) then
		scan_due = true
		if cfg().triggerbot.toggle then
			toggle_on = not toggle_on
		end
	end
	if code == aim_keycode_now() then
		scan_due = true
		if cfg().aimbot.toggle then
			aim_toggle_on = not aim_toggle_on
		end
	end
	if code == keycode(cfg().esp) then
		local esp_section = cfg().esp
		esp_section.enabled = esp_section.enabled ~= true
	end
	if code == gun_macro_keycode() then
		scan_due = true
			gun_macro_state.manual = true
			gun_macro_state.active = true
			gun_macro_state.phase = "swap1"
			gun_macro_state.ready_at = 0
			gun_macro_state.swap_deadline = os.clock() + 0.25
			gun_macro_state.home_gun = held_tool_name
		end
end)

connect(uis.InputEnded, function(input, _GameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local code = input.KeyCode
	keys_down[code] = nil
	if code == Enum.KeyCode.LeftControl or code == Enum.KeyCode.RightControl then
		crouch_held = keys_down[Enum.KeyCode.LeftControl] == true or keys_down[Enum.KeyCode.RightControl] == true
	end
	if code == gun_macro_keycode() then
		gun_macro_state.manual = false
		if not gun_macro_state.auto then
			gun_macro_state.active = false
		end
	end
end)

-- Heartbeat keeps firing/input logic at the engine rate. Expensive viewport,
-- LOS, and aim-part scans are capped at 60 Hz; cached-rect tests remain at the
-- full heartbeat rate.
local function run_frame(dt)
	if not camera or not camera.Parent then
		camera = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
		if camera then
			worldtoviewportpoint = camera.WorldToViewportPoint
		end
	end
	if not camera then
		return
	end

	local mp = mouse_pos()
	if mp then
		mouse_x, mouse_y = mp.X, mp.Y
	end

	local now = clock()

	-- Check physical key state to prevent manual gun macro from getting stuck if focus lost
	local gm_code = gun_macro_keycode()
	if gun_macro_state.manual and gm_code then
		if keys_down[gm_code] ~= true and not uis:IsKeyDown(gm_code) then
			gun_macro_state.manual = false
		end
	end

	-- Evaluate gun-macro state BEFORE scan_trigger so gm_scan_active is fresh for this frame's scan
	local gm_cfg = cfg().triggerbot and cfg().triggerbot.gun_macro
	local auto_gm = gm_cfg and gun_macro_auto_active(gm_cfg)
	gun_macro_state.auto = auto_gm
	if (auto_gm or gun_macro_state.manual) and not gun_macro_state.active then
		gun_macro_state.active = true
		gun_macro_state.phase = "swap1"
		gun_macro_state.ready_at = 0
		gun_macro_state.swap_deadline = now + 0.25
		gun_macro_state.home_gun = held_tool_name
	end
	if not auto_gm and not gun_macro_state.manual and gun_macro_state.active then
		gun_macro_state.active = false
		local home = gun_macro_state.home_gun
		local held_name = held_tool_name
		local held_macro_gun = gm_cfg and (held_name == gm_cfg.primary or held_name == gm_cfg.secondary)
		if home and held_macro_gun and not held_is(home) and not is_ko(client) then
			equip_tool_by_name(home)
		end
		gun_macro_state.home_gun = nil
	end
	local gm_cycling = gm_cfg and gm_cfg.enabled and gun_macro_state.active
	gm_scan_active = gm_cycling

	scan_accumulator = scan_accumulator + dt
	if scan_due or scan_accumulator >= scan_interval then
		scan_due = false
		scan_accumulator = 0
		scan_trigger()
		aimbot_pick()
	end

	-- during macro swap/cooldown phases the macro isn't firing, so the
	-- plain triggerbot keeps the held gun shooting (no dead gaps between
	-- bursts). only shoot1/shoot2 suppress it: the macro owns those
	-- windows, and firing twice would double-shoot.
	local gm_phase = gm_cycling and gun_macro_state.phase
	if not gm_cycling or (gm_phase ~= "shoot1" and gm_phase ~= "shoot2") then
		trigger_fast_check()
	else
		render_target = nil
	end	

	auto_swap_tick(now)

	if gm_cycling then
		gun_macro_tick(now, gm_cfg)
	end
end

-- render (visuals only, runs at render rate)
local last_visible_state = false

local function render_frame(dt)
	if not camera or not camera.Parent then
		camera = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
		if camera then
			worldtoviewportpoint = camera.WorldToViewportPoint
		end
	end
	if not camera then
		return
	end

	local triggerbot = cfg().triggerbot
	local aimbot = cfg().aimbot
	local gm = triggerbot and triggerbot.gun_macro
	local gm_fov = gm and gm.fov

	-- hide check: fast path when nothing at all is visible
	local esp_cfg = cfg().esp
	local esp_enabled = esp_cfg ~= nil and esp_cfg.enabled == true
	local gm_fov_visible = gm_fov and gm_fov.visible and gm_fov.enabled ~= false
	if not (triggerbot and triggerbot.visible or (aimbot and aimbot.visible) or gm_fov_visible or esp_enabled) then
		if last_visible_state then
			hide_all_boxes()
			hide_all_esp()
			if gm_fov_circle then
				gm_fov_circle.Visible = false
			end
			if fov_circle then
				fov_circle.Visible = false
			end
			last_visible_state = false
		end
		return
	end
	last_visible_state = true

	if fov_circle then
		local fov_cfg = aimbot and aimbot.fov
		local fov_rad = fov_cfg and tonumber(fov_cfg.radius) or 65
		local fov_col = fov_cfg and typeof(fov_cfg.color) == "Color3" and fov_cfg.color or Color3.new(1, 1, 1)
		fov_circle.Position = vector2new(mouse_x, mouse_y)
		fov_circle.Radius = fov_rad
		fov_circle.Color = fov_col
		fov_circle.Visible = (aimbot and aimbot.enabled and aimbot.visible) == true
	end

	if gm_fov_circle then
		local gm_rad = gm_fov and tonumber(gm_fov.radius) or 100
		local gm_col = gm_fov and typeof(gm_fov.color) == "Color3" and gm_fov.color or Color3.new(1, 1, 0)
		gm_fov_circle.Position = vector2new(mouse_x, mouse_y)
		gm_fov_circle.Radius = gm_rad
		gm_fov_circle.Color = gm_col
		gm_fov_circle.Visible = (gm_fov_visible and gm and gm.enabled) == true
	end

	if triggerbot.visible then
		for _, p in cached_players do
			if p ~= client then
				draw_box(p, p == render_target and triggerbot.box.inside or triggerbot.box.outside)
			end
		end
	else
		hide_all_boxes()
	end

	if esp_enabled then
		render_esp()
	else
		hide_all_esp()
	end
end

-- Expensive scans run at 60 Hz; cached trigger decisions and the macro state
-- machine run every heartbeat. Visuals stay on RenderStepped.
connect(runservice.Heartbeat, run_frame)
connect(runservice.RenderStepped, render_frame)

local cfg0 = getgenv().absolve
