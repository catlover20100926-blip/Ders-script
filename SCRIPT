	-------------------------------------------------------------------
	-- PATH-BASED CONFIG GETTER & SETTER
	-------------------------------------------------------------------
	local function path_parts(path: string): {string}
		local parts = {}
		local i = 1
		local len = #path
		while i <= len do
			local c = string.sub(path, i, i)
			if c == "." then
				i = i + 1
			elseif c == "[" then
				local close_idx = string.find(path, "%]", i)
				if close_idx then
					table.insert(parts, string.sub(path, i, close_idx))
					i = close_idx + 1
				else
					table.insert(parts, string.sub(path, i))
					break
				end
			else
				local next_dot = string.find(path, "[%.%[]", i)
				if next_dot then
					table.insert(parts, string.sub(path, i, next_dot - 1))
					i = next_dot
				else
					table.insert(parts, string.sub(path, i))
					break
				end
			end
		end
		return parts
	end

	local function get_at_path(path: string): any
		local cfg = getgenv().absolve
		if type(cfg) ~= "table" then return nil end
		local parts = path_parts(path)
		local curr = cfg
		for _, part in ipairs(parts) do
			if type(curr) ~= "table" then return nil end
			curr = curr[part]
		end
		return curr
	end

	local function set_at_path(path: string, val: any)
		local cfg = getgenv().absolve
		if type(cfg) ~= "table" then return end
		local parts = path_parts(path)
		local curr = cfg
		for i = 1, #parts - 1 do
			local part = parts[i]
			if type(curr[part]) ~= "table" then
				curr[part] = {}
			end
			curr = curr[part]
		end
		if #parts > 0 then
			curr[parts[#parts]] = val
		end
	end

	-------------------------------------------------------------------
	-- CONFIG FILE MANAGEMENT (Save / Load / Profiles)
	-------------------------------------------------------------------
	local MEMORY_PROFILES: { [string]: string } = {}

	local function ensure_config_dir()
		pcall(function()
			local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
			local mk = genv.makefolder or makefolder
			local isf = genv.isfolder or isfolder
			if type(mk) == "function" then
				if type(isf) == "function" then
					if not isf("absolve") then mk("absolve") end
					if not isf("absolve/configs") then mk("absolve/configs") end
				else
					mk("absolve")
					mk("absolve/configs")
				end
			end
		end)
	end

	local function save_profile_file(name: string): (boolean, string?)
		ensure_config_dir()
		local cfg = getgenv().absolve
		if type(cfg) ~= "table" then
			return false, "No active config in memory"
		end
		local ok, encoded = pcall(function()
			return http_service:JSONEncode(cfg)
		end)
		if not ok or not encoded then
			return false, "Failed to serialize JSON"
		end

		MEMORY_PROFILES[name] = encoded

		local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
		local wf = genv.writefile or writefile
		if type(wf) == "function" then
			local w_ok = pcall(function()
				wf("absolve/configs/" .. name .. ".json", encoded)
			end)
			if not w_ok then
				pcall(function()
					wf("absolve_cfg_" .. name .. ".json", encoded)
				end)
			end
		end
		return true, nil
	end

	local function load_profile_file(name: string): (boolean, string?)
		local raw_json: string? = nil
		local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
		local isf = genv.isfile or isfile
		local rf = genv.readfile or readfile

		local f1 = "absolve/configs/" .. name .. ".json"
		local f2 = "absolve_cfg_" .. name .. ".json"

		if type(isf) == "function" and isf(f1) and type(rf) == "function" then
			pcall(function() raw_json = rf(f1) end)
		end
		if not raw_json and type(isf) == "function" and isf(f2) and type(rf) == "function" then
			pcall(function() raw_json = rf(f2) end)
		end
		if not raw_json and MEMORY_PROFILES[name] then
			raw_json = MEMORY_PROFILES[name]
		end
		if not raw_json then
			return false, "Config '" .. name .. "' not found"
		end

		local ok, decoded = pcall(function()
			return http_service:JSONDecode(raw_json)
		end)
		if not ok or type(decoded) ~= "table" then
			return false, "Malformed JSON profile data"
		end

		for k, v in pairs(decoded) do
			getgenv().absolve[k] = v
		end
		return true, nil
	end

	local function list_saved_profiles(): {string}
		local names = {}
		local seen = {}
		local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
		local lf = genv.listfiles or listfiles

		if type(lf) == "function" then
			pcall(function()
				for _, p in ipairs(lf("absolve/configs")) do
					local m = string.match(p, "([%w_%-]+)%.json$")
					if m and not seen[m] then
						seen[m] = true
						table.insert(names, m)
					end
				end
			end)
		end
		for m in pairs(MEMORY_PROFILES) do
			if not seen[m] then
				seen[m] = true
				table.insert(names, m)
			end
		end
		if #names == 0 then
			table.insert(names, "default")
		end
		return names
	end

