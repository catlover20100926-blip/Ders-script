local function color_to_hex(color)
	local r = math.clamp(math.floor(color.R * 255 + 0.5), 0, 255)
	local g = math.clamp(math.floor(color.G * 255 + 0.5), 0, 255)
	local b = math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
	return string.format("#%02X%02X%02X", r, g, b)
end

local function hex_to_color(value)
	if type(value) ~= "string" then
		return nil
	end
	local hex = string.match(value, "^#?(%x%x%x%x%x%x)$")
	if not hex then
		return nil
	end
	return Color3.fromRGB(
		tonumber(string.sub(hex, 1, 2), 16),
		tonumber(string.sub(hex, 3, 4), 16),
		tonumber(string.sub(hex, 5, 6), 16)
	)
end

local function export_value(value)
	if typeof(value) == "Color3" then
		return color_to_hex(value)
	end
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = export_value(child)
	end
	return result
end

local function clone_value(value)
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in pairs(value) do
		result[key] = clone_value(child)
	end
	return result
end

local function number_range(path)
	local leaf = string.match(path, "([%w_]+)$")
	if string.find(path, ".box.", 1, true) and (leaf == "width" or leaf == "height" or leaf == "depth") then
		return 0.1, 100
	end
	if leaf == "radius" then
		return 0, 5000
	end
	if leaf == "smoothness" then
		return 0.001, 1
	end
	if leaf == "range" then
		return 0, 10000
	end
	if leaf == "speed_factor" then
		return 0, 1
	end
	if leaf == "click_interval" or leaf == "exit_buffer" or leaf == "swap" or leaf == "shoot_duration" or leaf == "cycle" then
		return 0, 10
	end
	return -1000000, 1000000
end

local function validate_remote_into(target, incoming, path)
	for key, value in pairs(incoming) do
		local child_path = path == "" and tostring(key) or (path .. "." .. tostring(key))
		-- Connection details stay local and are intentionally ignored even in
		-- workspace profiles; the browser cannot redirect the executor client.
		if not (path == "" and key == "remote_control") then
			local current = target[key]
			if current == nil then
				return false, "unknown setting: " .. child_path
			elseif typeof(current) == "Color3" then
				local parsed = hex_to_color(value)
				if not parsed then
					return false, "invalid color: " .. child_path
				end
				target[key] = parsed
			elseif type(current) == "table" then
				if type(value) ~= "table" then
					return false, "expected object: " .. child_path
				end
				local ok, reason = validate_remote_into(current, value, child_path)
				if not ok then
					return false, reason
				end
			elseif type(current) ~= type(value) then
				return false, "wrong type: " .. child_path
			elseif type(value) == "number" then
				if value ~= value or value == math.huge or value == -math.huge then
					return false, "number must be finite: " .. child_path
				end
				local minimum, maximum = number_range(child_path)
				if value < minimum or value > maximum then
					return false, string.format("out of range: %s (%g to %g)", child_path, minimum, maximum)
				end
				target[key] = value
			elseif type(value) == "string" then
				if string.match(child_path, "%.key$") then
					local normalized = #value == 1 and string.upper(value) or value
					if Enum.KeyCode[normalized] == nil then
						return false, "invalid key: " .. child_path
					end
					target[key] = normalized
				elseif child_path == "triggerbot.mode" then
					if value ~= "gun-macro" and value ~= "auto-swap" and value ~= "plain" then
						return false, "invalid triggerbot mode"
					end
					target[key] = value
				elseif child_path == "esp.filter_mode" then
					if value ~= "everyone" and value ~= "marked" and value ~= "enemies" and value ~= "friends" then
						return false, "invalid esp filter mode"
					end
					target[key] = value
				else
					target[key] = value
				end
			else
				target[key] = value
			end
		end
	end
	return true
end

local function commit_value(target, source)
	for key, value in pairs(source) do
		if type(value) == "table" and type(target[key]) == "table" then
			commit_value(target[key], value)
		else
			target[key] = value
		end
	end
end

-- Validate against a private copy and commit only after the entire payload
-- passes. A bad field can no longer leave half of a live config applied.
local function apply_remote_config(incoming)
	if type(incoming) ~= "table" then
		return false, "config must be an object"
	end
	local candidate = clone_value(cfg())
	local ok, reason = validate_remote_into(candidate, incoming, "")
	if not ok then
		return false, reason
	end
	local triggerbot = candidate.triggerbot
	local macro = triggerbot and triggerbot.gun_macro
	if macro and (triggerbot.guns[macro.primary] == nil or triggerbot.guns[macro.secondary] == nil) then
		return false, "gun-macro primary and secondary must name configured guns"
	end
	commit_value(cfg(), candidate)
	return true
end

local function safe_config_name(name)
	name = tostring(name or "default")
	name = string.gsub(name, "[^%w_%-]", "_")
	if name == "" then
		name = "default"
	end
	return string.sub(name, 1, 64)
end

local function ensure_config_folder()
	if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
		return false, "executor filesystem API is unavailable"
	end
	local remote = cfg() and cfg().remote_control
	local folder = (type(remote) == "table" and remote.config_folder) or "absolve/configs"
	local current = ""
	for part in string.gmatch(folder, "[^/\\]+") do
		current = current == "" and part or (current .. "/" .. part)
		if not isfolder(current) then
			makefolder(current)
		end
	end
	return true
end

local function config_path(name)
	local remote = cfg() and cfg().remote_control
	local folder = (type(remote) == "table" and remote.config_folder) or "absolve/configs"
	return folder .. "/" .. safe_config_name(name) .. ".json"
end

