		kb_lbl.TextXAlignment = Enum.TextXAlignment.Left
		kb_lbl.ZIndex = 3
		kb_lbl.Parent = kb_row

		local kb_btn = Instance.new("TextButton")
		kb_btn.Size = UDim2.new(0, 125, 0, 26)
		kb_btn.Position = UDim2.new(1, -125, 0.5, -13)
		kb_btn.BackgroundColor3 = Color3.fromRGB(48, 32, 54)
		kb_btn.Text = "[" .. menu_toggle_key.Name .. "]"
		kb_btn.TextColor3 = THEME.primary
		kb_btn.TextSize = 11
		set_comfortaa_font(kb_btn, true)
		kb_btn.ZIndex = 3
		kb_btn.Parent = kb_row

		local kb_corner = Instance.new("UICorner")
		kb_corner.CornerRadius = UDim.new(0, 6)
		kb_corner.Parent = kb_btn

		local kb_conn = nil
		kb_btn.MouseButton1Click:Connect(function()
			if is_binding_menu_key then return end
			is_binding_menu_key = true
			kb_btn.Text = "[Press Key...]"
			kb_btn.TextColor3 = Color3.fromRGB(255, 230, 100)
			kb_btn.BackgroundColor3 = THEME.primary

			kb_conn = uis.InputBegan:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.Keyboard then
					if inp.KeyCode ~= Enum.KeyCode.Unknown then
						if inp.KeyCode ~= Enum.KeyCode.Escape then
							menu_toggle_key = inp.KeyCode
							save_menu_key(inp.KeyCode.Name)
						end
						kb_btn.Text = "[" .. menu_toggle_key.Name .. "]"
						kb_btn.TextColor3 = THEME.primary
						kb_btn.BackgroundColor3 = Color3.fromRGB(48, 32, 54)
						is_binding_menu_key = false
						if kb_conn then
							kb_conn:Disconnect()
							kb_conn = nil
						end
					end
				end
			end)
		end)
	end

