			local kb_corner = Instance.new("UICorner")
			kb_corner.CornerRadius = UDim.new(0, 6)
			kb_corner.Parent = key_btn

			local capturing = false
			local conn

			key_btn.MouseButton1Click:Connect(function()
				if capturing then return end
				capturing = true
				key_btn.Text = "[Press Key...]"
				key_btn.BackgroundColor3 = THEME.primary
				key_btn.TextColor3 = Color3.new(1, 1, 1)

				conn = uis.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						local key_name = input.KeyCode.Name
						if key_name ~= "Unknown" and key_name ~= "Escape" then
							set_at_path(path, key_name)
							key_btn.Text = "[" .. key_name .. "]"
						elseif key_name == "Escape" then
							key_btn.Text = (val_str ~= "" and ("[" .. val_str .. "]")) or "[None]"
						end
						key_btn.BackgroundColor3 = Color3.fromRGB(52, 36, 60)
						key_btn.TextColor3 = THEME.secondary
						capturing = false
						if conn then conn:Disconnect() end
					end
				end)
			end)
		else
			local txt_box = Instance.new("TextBox")
			txt_box.Size = UDim2.new(0.42, 0, 0, 24)
			txt_box.Position = UDim2.new(0.58, 0, 0.5, -12)
			txt_box.BackgroundColor3 = Color3.fromRGB(52, 36, 60)
			txt_box.Text = val_str
			txt_box.TextColor3 = Color3.new(1, 1, 1)
			txt_box.TextSize = 11
			set_comfortaa_font(txt_box, false)
			txt_box.ZIndex = 3
			txt_box.Parent = row

			local tb_corner = Instance.new("UICorner")
			tb_corner.CornerRadius = UDim.new(0, 6)
			tb_corner.Parent = txt_box

			txt_box.FocusLost:Connect(function()
				set_at_path(path, txt_box.Text)
			end)
		end
	end

