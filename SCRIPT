		return false, reason
	end
	local encoded = httpservice:JSONEncode(export_value(cfg()))
	writefile(config_path(name), encoded)
	return true, "saved " .. safe_config_name(name)
end

local function load_workspace_config(name)
	if type(readfile) ~= "function" or type(isfile) ~= "function" then
		return false, "executor readfile API is unavailable"
	end
	local path = config_path(name)
	if not isfile(path) then
		return false, "config not found: " .. safe_config_name(name)
	end
	local decoded = httpservice:JSONDecode(readfile(path))
	if type(decoded) ~= "table" then
		return false, "saved config is invalid"
	end
	local applied, reason = apply_remote_config(decoded)
	if not applied then
		return false, reason
	end
	on_config_applied()
	return true, "loaded " .. safe_config_name(name)
end

local executor_request = request
if type(executor_request) ~= "function" and type(http_request) == "function" then
	executor_request = http_request
end

local function control_request(method, path, body)
	if type(executor_request) ~= "function" then
		return nil
	end
	local remote = cfg() and cfg().remote_control
	if not remote or not remote.url then
		return nil
	end
	local options = {
		Url = remote.url .. path,
		Method = method,
		Headers = { ["Content-Type"] = "application/json" },
	}
	if body ~= nil then
		options.Body = httpservice:JSONEncode(body)
	end
	local ok, response = pcall(executor_request, options)
	if ok and type(response) == "table" and response.Success ~= false then
		return response
	end
	return nil
end

local function report_control_status(ok, message)
	pcall(control_request, "POST", "/api/status", {
		connected = true,
		ok = ok,
		message = message,
		updatedAt = os.time(),
	})
end

local function publish_runtime_config()
	pcall(control_request, "POST", "/api/runtime", {
		config = export_value(cfg()),
	})
end

-- assigned once the relations system is defined further below; the poll
-- loop treats it as optional until then
local sync_players

task.spawn(function()
	local last_revision = -1
	local last_command_id = 0
	local last_server_instance = nil
	while runtime.alive do
		local remote = cfg().remote_control
		if remote and remote.enabled then
			local ok, response = pcall(control_request, "GET", "/api/state")
			if ok and response and type(response.Body) == "string" then
				local decoded_ok, state = pcall(httpservice.JSONDecode, httpservice, response.Body)
				if decoded_ok and type(state) == "table" then
					if type(state.instance) == "string" and state.instance ~= last_server_instance then
						last_server_instance = state.instance
						last_command_id = 0
						last_revision = -1
					end
					if type(state.revision) == "number" and state.revision ~= last_revision and type(state.config) == "table" then
						last_revision = state.revision
						local applied, reason = apply_remote_config(state.config)
						if applied then
							on_config_applied()
							-- in-game proof of what was applied (the panel pill
							-- is easy to miss; rejected payloads used to be
							-- completely silent here)
							print(string.format(
								"[absolve] config rev %d applied | gm timing swap=%g shoot=%g cycle=%g",
								state.revision,
								cfg().triggerbot.gun_macro.timing.swap or -1,
								cfg().triggerbot.gun_macro.timing.shoot_duration or -1,
								cfg().triggerbot.gun_macro.timing.cycle or -1
							))
							report_control_status(true, "live settings applied")
						else
							print("[absolve] config rev " .. tostring(state.revision) .. " REJECTED: " .. tostring(reason))
							report_control_status(false, tostring(reason))
						end
					end

					local commands = state.commands
					if type(commands) ~= "table" then
						commands = type(state.command) == "table" and { state.command } or {}
					end
					for _, command in ipairs(commands) do
						if type(command) ~= "table" or type(command.id) ~= "number" or command.id <= last_command_id then
							continue
						end
						last_command_id = command.id
						local action_ok, action_message
						if command.action == "save" then
							local call_ok, result_ok, result_message = pcall(save_workspace_config, command.name)
							action_ok = call_ok and result_ok
							action_message = call_ok and result_message or result_ok
						elseif command.action == "load" then
							local call_ok, result_ok, result_message = pcall(load_workspace_config, command.name)
							action_ok = call_ok and result_ok
							action_message = call_ok and result_message or result_ok
							if action_ok then
								publish_runtime_config()
							end
						else
							action_ok, action_message = false, "unknown command"
						end
						report_control_status(action_ok, tostring(action_message))
						pcall(control_request, "POST", "/api/command/ack", { id = command.id })
					end
				end
			end

			if sync_players then
				pcall(sync_players)
			end

			task.wait(math.max(tonumber(remote.poll_interval) or 0.25, 0.1))
		else
			task.wait(1)
		end
	end
end)

local particle_watch = setmetatable({}, { __mode = "k" })

local function remove_particles(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant:Destroy()
		end
	end
end

-- Deletes particle emitters and installs at most one listener set per tool.
-- Re-equipping the same instance no longer stacks Default.ChildAdded hooks.
local function clean_tool_particles(tool)
	local cp = cfg() and cfg().clean_particles
	if not (cp and cp.enabled ~= false) then
		return
	end
	if particle_watch[tool] then
		return
	end

	local state = { default = nil, default_connection = nil }
	particle_watch[tool] = state

	local function bind_default(default_child)
		if state.default == default_child then
			return
		end
		if state.default_connection then
			state.default_connection:Disconnect()
			state.default_connection = nil
		end
		state.default = default_child
		if not default_child then
			return
		end
		remove_particles(default_child)
		state.default_connection = connect(default_child.ChildAdded, function(child)
			if child:IsA("ParticleEmitter") then
				child:Destroy()
			else
				remove_particles(child)
			end
		end)
	end

	bind_default(tool:FindFirstChild("Default"))
	state.tool_connection = connect(tool.ChildAdded, function(child)
		if child.Name == "Default" then
			bind_default(child)
		end
	end)
end

local backpack_conns = {}

local function bind_container(container, connections)
	if not container then
		return
	end
	for _, tool in container:GetChildren() do
		if tool:IsA("Tool") then
			watch_tool(tool)
		end
	end
	table.insert(connections, connect(container.ChildAdded, function(child)
		if child:IsA("Tool") then
			watch_tool(child)
		end
	end))
	table.insert(connections, connect(container.ChildRemoved, function(child)
		if child:IsA("Tool") then
			if not same_tool_exists(child) then
				unwatch_tool(child)
			end
		end
	end))
end

local function bind_backpack(backpack)
	for _, connection in ipairs(backpack_conns) do
		connection:Disconnect()
	end
	backpack_conns = {}
	bind_container(backpack, backpack_conns)
	prune_tool_watches()
end

local char_conns = {}

local function bind_character(char)
	for _, c in ipairs(char_conns) do
		c:Disconnect()
	end
	char_conns = {}
	if not char then
		set_held_tool(nil)
		prune_tool_watches()
		return
	end
	set_held_tool(char:FindFirstChildOfClass("Tool"))
	if held_tool then
		clean_tool_particles(held_tool)
	end
	table.insert(char_conns, connect(char.ChildAdded, function(child)
		if child:IsA("Tool") then
			watch_tool(child)
			set_held_tool(child)
			clean_tool_particles(child)
		end
	end))
	table.insert(char_conns, connect(char.ChildRemoved, function(child)
		if child:IsA("Tool") then
			if child == held_tool then
				set_held_tool(nil)
			end
			if not same_tool_exists(child) then
				unwatch_tool(child)
			end
		end
	end))
	prune_tool_watches()
end

