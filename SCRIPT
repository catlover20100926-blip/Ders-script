	-- INITIALIZE DEFAULT TAB & TOGGLE KEYBIND
	-------------------------------------------------------------------
	if nav_buttons["triggerbot"] then
		nav_buttons["triggerbot"]()
	end

	uis.InputBegan:Connect(function(input, gpe)
		if gpe or is_binding_menu_key then
			return
		end
		if input.KeyCode == menu_toggle_key or input.KeyCode == Enum.KeyCode.Insert then
			main_frame.Visible = not main_frame.Visible
		end
	end)

	print("[Liyah's Gui] Loaded with Comfortaa font, 1:1 background & settings profile manager. Toggle: [" .. menu_toggle_key.Name .. "]")
