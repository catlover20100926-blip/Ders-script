-- MacroX hook: the game's own macro script (PlayerScripts.MacroX) binds its
-- macro to a key read live from LocalPlayer.DataFolder.Information.Macro
-- (a StringValue, e.g. "V") and treats the key as held while the user is
-- macroing (its u1 flag). replicate that exact signal: cache the key from
-- the same StringValue, keep it in sync on Changed, and report "macroing"
-- when that key is currently held down.
local macro_x_key = Enum.KeyCode.X
local macro_x_value = nil
local macro_x_connection = nil

local function update_macro_x_key()
	local value = macro_x_value and macro_x_value.Value or "X"
	if #value == 1 then
		value = string.upper(value)
	end
	macro_x_key = Enum.KeyCode[value] or Enum.KeyCode.X
end

local function refresh_macro_x_binding()
	local info = client:FindFirstChild("DataFolder")
	if info then
		info = info:FindFirstChild("Information")
	end
	local value = info and info:FindFirstChild("Macro")
	if value and not value:IsA("StringValue") then
		value = nil
	end
	if value == macro_x_value then
		update_macro_x_key()
		return
	end
	if macro_x_connection then
		macro_x_connection:Disconnect()
		macro_x_connection = nil
	end
	macro_x_value = value
	update_macro_x_key()
	if value then
		macro_x_connection = connect(value.Changed, update_macro_x_key)
	end
end

