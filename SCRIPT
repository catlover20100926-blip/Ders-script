	-- 2. Number Field (Interactive Slider + Direct Numeric Input)
	local function render_number_field(parent, path: string, label: string, step_val: number?)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 46)
		row.BackgroundTransparency = 1
		row.ZIndex = 3
		row.Parent = parent

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(0.65, 0, 0, 18)
		lbl.BackgroundTransparency = 1
		lbl.Text = label
		lbl.TextColor3 = THEME.text_main
		lbl.TextSize = 12
		set_comfortaa_font(lbl, false)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.ZIndex = 3
		lbl.Parent = row

		local init_val = tonumber(get_at_path(path)) or 0
		local fmt = (step_val and step_val < 0.01) and "%.4f" or ((step_val and step_val < 0.1) and "%.3f" or ((step_val and step_val < 1) and "%.2f" or "%d"))

		local val_box = Instance.new("TextBox")
		val_box.Size = UDim2.new(0.32, 0, 0, 20)
		val_box.Position = UDim2.new(0.68, 0, 0, 0)
		val_box.BackgroundColor3 = Color3.fromRGB(48, 32, 54)
		val_box.Text = string.format(fmt, init_val)
		val_box.TextColor3 = THEME.secondary
		val_box.TextSize = 11
		set_comfortaa_font(val_box, true)
		val_box.ZIndex = 3
		val_box.Parent = row

		local vb_corner = Instance.new("UICorner")
		vb_corner.CornerRadius = UDim.new(0, 6)
		vb_corner.Parent = val_box

		local slider_track = Instance.new("Frame")
		slider_track.Size = UDim2.new(1, 0, 0, 6)
		slider_track.Position = UDim2.new(0, 0, 0, 28)
		slider_track.BackgroundColor3 = Color3.fromRGB(48, 38, 68)
		slider_track.BorderSizePixel = 0
		slider_track.ZIndex = 3
		slider_track.Parent = row

		local track_corner = Instance.new("UICorner")
		track_corner.CornerRadius = UDim.new(1, 0)
		track_corner.Parent = slider_track

		local min_val = 0
		local max_val = 1
		if init_val > 100 then
			min_val = 0
			max_val = math.max(init_val * 2, 2000)
		elseif init_val > 10 then
			min_val = 0
			max_val = math.max(init_val * 2, 100)
		elseif init_val > 1 then
			min_val = 0
			max_val = math.max(init_val * 2, 20)
		elseif init_val > 0 then
			min_val = 0
			max_val = math.max(init_val * 3, 1)
		elseif init_val < 0 then
			min_val = init_val * 2
			max_val = -init_val
		else
			min_val = 0
			max_val = 10
		end

		local rel = math.clamp((init_val - min_val) / math.max(max_val - min_val, 0.0001), 0, 1)

		local slider_fill = Instance.new("Frame")
		slider_fill.Size = UDim2.new(rel, 0, 1, 0)
		slider_fill.BackgroundColor3 = THEME.primary
		slider_fill.BorderSizePixel = 0
		slider_fill.ZIndex = 3
		slider_fill.Parent = slider_track

		local fill_corner = Instance.new("UICorner")
		fill_corner.CornerRadius = UDim.new(1, 0)
		fill_corner.Parent = slider_fill

		local thumb = Instance.new("Frame")
		thumb.Size = UDim2.new(0, 14, 0, 14)
		thumb.Position = UDim2.new(1, -7, 0.5, -7)
		thumb.BackgroundColor3 = Color3.new(1, 1, 1)
		thumb.BorderSizePixel = 0
		thumb.ZIndex = 4
		thumb.Parent = slider_fill

		local thumb_corner = Instance.new("UICorner")
		thumb_corner.CornerRadius = UDim.new(1, 0)
		thumb_corner.Parent = thumb

		local active_slide = false

		local function update_from_input(input)
			local abs_pos = slider_track.AbsolutePosition.X
			local abs_size = math.max(slider_track.AbsoluteSize.X, 1)
			local pct = math.clamp((input.Position.X - abs_pos) / abs_size, 0, 1)
			slider_fill.Size = UDim2.new(pct, 0, 1, 0)
			local actual = min_val + pct * (max_val - min_val)
			if step_val and step_val >= 1 then
				actual = math.round(actual)
			end
			val_box.Text = string.format(fmt, actual)
			set_at_path(path, actual)
		end

		slider_track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				active_slide = true
				update_from_input(input)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						active_slide = false
					end
				end)
			end
		end)

		uis.InputChanged:Connect(function(input)
			if active_slide and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update_from_input(input)
			end
		end)

		val_box.FocusLost:Connect(function()
			local num = tonumber(val_box.Text)
			if num then
				set_at_path(path, num)
				local pct = math.clamp((num - min_val) / math.max(max_val - min_val, 0.0001), 0, 1)
				slider_fill.Size = UDim2.new(pct, 0, 1, 0)
			else
				val_box.Text = string.format(fmt, tonumber(get_at_path(path)) or 0)
			end
		end)
	end

