		t_thumb_corner.Parent = t_thumb

		local t_sliding = false
		local function update_transparency(input)
			local abs_pos = t_track.AbsolutePosition.X
			local abs_size = math.max(t_track.AbsoluteSize.X, 1)
			local pct = math.clamp((input.Position.X - abs_pos) / abs_size, 0, 1)
			t_fill.Size = UDim2.new(pct, 0, 1, 0)
			t_val_lbl.Text = math.round(pct * 100) .. "%"
			card_transparency = pct
			for _, descendant in ipairs(content_container:GetDescendants()) do
				if descendant:IsA("Frame") and string.find(descendant.Name, "^Card_") then
					descendant.BackgroundTransparency = card_transparency
				end
			end
		end

		t_track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				t_sliding = true
				update_transparency(input)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						t_sliding = false
					end
				end)
			end
		end)

		uis.InputChanged:Connect(function(input)
			if t_sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				update_transparency(input)
			end
		end)

