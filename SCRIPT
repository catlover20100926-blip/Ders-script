				ql_corner.CornerRadius = UDim.new(0, 4)
				ql_corner.Parent = p_load_quick

				p_load_quick.MouseButton1Click:Connect(function()
					profile_input.Text = p_name
					local ok, err = load_profile_file(p_name)
					if ok then
						status_msg.Text = "Loaded profile '" .. p_name .. "' successfully!"
						status_msg.TextColor3 = Color3.fromRGB(34, 197, 94)
					else
						status_msg.Text = "Error loading: " .. tostring(err)
						status_msg.TextColor3 = Color3.fromRGB(240, 68, 68)
