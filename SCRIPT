	local function resolve_bg_image(): string
		local genv = (type(getgenv) == "function" and (getgenv() :: any)) or {}
		local gasset = (type(genv.getcustomasset) == "function" and genv.getcustomasset)
			or (type(genv.getsynasset) == "function" and genv.getsynasset)
			or (type(getcustomasset) == "function" and (getcustomasset :: any))

		if type(gasset) == "function" then
			local fname = "absolve_bg.jpg"
			if type(isfile) == "function" and isfile(fname) then
				return gasset(fname)
			end
			if type(writefile) == "function" then
