	-------------------------------------------------------------------
	-- 1:1 EMBEDDED BACKGROUND ASSET RESOLVER
	-------------------------------------------------------------------
	local b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local b64_lut = {}
	for i = 1, #b64_chars do
		b64_lut[string.byte(b64_chars, i)] = i - 1
	end

	local function decode_base64(data: string): string
		local len = #data
		local padding = 0
		if string.sub(data, -1) == "=" then padding = padding + 1 end
		if string.sub(data, -2, -2) == "=" then padding = padding + 1 end

		local out = table.create(math.ceil(len * 3 / 4))
		local out_idx = 1
		local i = 1
		while i <= len do
			local b1 = b64_lut[string.byte(data, i)] or 0
			local b2 = b64_lut[string.byte(data, i + 1)] or 0
			local b3 = b64_lut[string.byte(data, i + 2)] or 0
			local b4 = b64_lut[string.byte(data, i + 3)] or 0

			local n = bit32.bor(bit32.lshift(b1, 18), bit32.lshift(b2, 12), bit32.lshift(b3, 6), b4)
			out[out_idx] = string.char(bit32.rshift(n, 16), bit32.band(bit32.rshift(n, 8), 0xFF), bit32.band(n, 0xFF))
			out_idx = out_idx + 1
			i = i + 4
		end

		local res = table.concat(out)
		if padding > 0 then
			res = string.sub(res, 1, #res - padding)
		end
		return res
	end

