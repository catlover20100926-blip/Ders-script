-- ==== event-driven tool state ====
-- held-tool cache: no per-frame FindFirstChildOfClass. Character
-- ChildAdded/ChildRemoved update the equipped tool the moment it changes.
local held_tool = nil
local held_tool_name = nil
local held_tool_knife = false

local function set_held_tool(tool)
	held_tool = tool
	if tool then
		held_tool_name = tool.Name
		held_tool_knife = string.find(string.lower(tool.Name), "knife", 1, true) ~= nil
	else
		held_tool_name = nil
		held_tool_knife = false
	end
end

-- Event-driven ammo cache keyed by tool INSTANCE. Two same-named tools can
-- have different ammo counts, so name-keying can report the wrong gun.
-- Ammo IntValue.Changed keeps it fresh, so nothing reads tool ammo per frame.
local tool_ammo = setmetatable({}, { __mode = "k" })
local ammo_conns = {}

-- Some games temporarily remove the Backpack instance during spawning.
-- Never index Player.Backpack directly because that property read throws
-- when the child does not currently exist.
local function current_backpack()
	return client:FindFirstChildOfClass("Backpack")
end

-- true when the same tool INSTANCE is still present (Character or Backpack).
-- used to keep the ammo connection alive across EquipTool parent moves.
local function same_tool_exists(tool)
	local parent = tool.Parent
	if parent ~= nil and parent == client.Character then
		return true
	end
	-- Parent inspection avoids querying Player.Backpack entirely. It remains
	-- valid during the brief window where the Backpack child does not exist.
	return parent ~= nil and parent:IsA("Backpack") and parent.Parent == client
end

local function watch_tool(tool)
	if ammo_conns[tool] then
		return
	end
	local ammo = tool:FindFirstChild("Ammo")
	if ammo and ammo:IsA("IntValue") then
		ammo_conns[tool] = connect(ammo.Changed, function(v)
			tool_ammo[tool] = v > 0
		end)
		tool_ammo[tool] = ammo.Value > 0
	else
		-- no Ammo value (e.g. melee) -> always "loaded"
		tool_ammo[tool] = true
	end
end

local function unwatch_tool(tool)
	local conn = ammo_conns[tool]
	if conn then
		conn:Disconnect()
		ammo_conns[tool] = nil
	end
	tool_ammo[tool] = nil
end

local function prune_tool_watches()
	local stale = {}
	for tool in pairs(tool_ammo) do
		if not same_tool_exists(tool) then
			table.insert(stale, tool)
		end
	end
	for _, tool in ipairs(stale) do
		unwatch_tool(tool)
	end
end

