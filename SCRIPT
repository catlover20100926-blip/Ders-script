		save_btn.MouseButton1Click:Connect(function()
			local p_name = string.gsub(profile_input.Text, "^%s*(.-)%s*$", "%1")
			if p_name == "" then p_name = "default" end
			local ok, err = save_profile_file(p_name)
			if ok then
				status_msg.Text = "Saved profile '" .. p_name .. "' successfully!"
				status_msg.TextColor3 = Color3.fromRGB(34, 197, 94)
				refresh_profile_list()
			else
				status_msg.Text = "Error saving: " .. tostring(err)
				status_msg.TextColor3 = Color3.fromRGB(240, 68, 68)
			end
		end)

		load_btn.MouseButton1Click:Connect(function()
			local p_name = string.gsub(profile_input.Text, "^%s*(.-)%s*$", "%1")
