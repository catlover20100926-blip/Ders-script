-- A re-execution replaces the previous runtime cleanly. Every persistent
-- connection and Drawing object is owned by this runtime, so reloads cannot
-- stack input handlers, frame loops, particle watchers, or ESP drawings.
local previous_runtime = getgenv().absolve_runtime
if type(previous_runtime) == "table" and type(previous_runtime.unload) == "function" then
	pcall(previous_runtime.unload)
end

local runtime = {
	alive = true,
	connections = {},
	drawings = {},
}

local function track_connection(connection)
	if connection then
		table.insert(runtime.connections, connection)
	end
	return connection
end

local function connect(signal, callback)
	return track_connection(signal:Connect(callback))
end

function runtime.unload()
	if not runtime.alive then
		return
	end
	runtime.alive = false
	for _, connection in ipairs(runtime.connections) do
		pcall(connection.Disconnect, connection)
	end
	for _, drawing in ipairs(runtime.drawings) do
		pcall(drawing.Remove, drawing)
	end
	if getgenv().absolve_runtime == runtime then
		getgenv().absolve_runtime = nil
		getgenv().absolve_low_unc_loaded = false
		getgenv().absolve_unload = nil
	end
end

getgenv().absolve_runtime = runtime
getgenv().absolve_unload = runtime.unload
