-- mousemoverel availability (present in Solara docs; multiple executor aliases supported)
local mousemoverel_fn = (type(mousemoverel) == "function" and mousemoverel)
	or (type(getgenv) == "function" and type(getgenv().mousemoverel) == "function" and getgenv().mousemoverel)
	or (type(getgenv) == "function" and type(getgenv().mouse_moverel) == "function" and getgenv().mouse_moverel)
	or nil

-- exponential smoothing with sub-pixel carry accumulation, delivered as
-- integer-relative moves, with a final 1px snap so the cursor always lands
-- on the point
local carry_x, carry_y = 0, 0
local last_move_time = 0

local function trunc(v)
	return v >= 0 and floor(v) or ceil(v)
end

local function move_mouse_to_point(tx, ty, mx, my, smoothness)
	local now = clock()
	local dt = now - last_move_time
	last_move_time = now
	if dt <= 0 or dt > 0.1 then
		dt = 0
	end

	local dx = tx - mx
	local dy = ty - my

	local s = clamp(smoothness or 0.1, 0.05, 1)
	local step = 1 - (1 - s) ^ (dt * 60)

	local move_x = dx * step + carry_x
	local move_y = dy * step + carry_y

	if abs(dx) <= 1 then
		move_x = dx
	end
	if abs(dy) <= 1 then
		move_y = dy
	end

	local ix = trunc(move_x)
	local iy = trunc(move_y)

	carry_x = clamp(move_x - ix, -2, 2)
	carry_y = clamp(move_y - iy, -2, 2)

	if (ix ~= 0 or iy ~= 0) and mousemoverel_fn then
		mousemoverel_fn(ix, iy)
	end
end

-- aimbot pick + move, runs at scan rate (60Hz): same smoothness (the
-- easing is dt-based so per-move magnitude is unchanged), but part scans
-- happen 4x less and far players are skipped with a single HRP projection
local function aimbot_pick()
	local aimbot = cfg().aimbot
	if not aimbot.enabled then
		return
	end
	if not is_aim_active() then
		return
	end

	-- non-sticky: re-pick the closest onscreen part to the cursor, no
	-- lock-on. if nothing is inside the fov, disable and reset.
	local mx, my = mouse_x, mouse_y
	local radius = aimbot.fov.radius
	local far_margin2 = (radius + 150) * (radius + 150)
	local close_dist = 40
	local ko_check = aimbot.checks.ko
	local cam_pos = camera.CFrame.Position

	local best_part, best_x, best_y = nil, 0, 0
	local best_d2 = huge

	local team_check = cfg().aimbot.checks.team ~= false

	for _, p in cached_players do
		if p == client or not p.Character or not target_allowed(p, team_check) then
			continue
		end
		if ko_check and is_ko(p) then
			continue
		end
		local refs = refs_for(p)
		local hum = refs.humanoid
		if not (hum and hum.Health > 0) then
			continue
		end
		-- cheap prefilter: skip far players whose root is nowhere near the
		-- cursor; close-range keeps the full part scan (limbs reach far)
		local hrp = refs.hrp
		if hrp then
			local delta = hrp.Position - cam_pos
			local dist3d2 = delta:Dot(delta)
			local hsp, hons = worldtoviewportpoint(camera, hrp.Position)
			if dist3d2 >= close_dist * close_dist then
				if not hons then
					continue
				end
				local hdx = hsp.X - mx
				local hdy = hsp.Y - my
				if hdx * hdx + hdy * hdy > far_margin2 then
					continue
				end
			end
		end
		for _, part in ipairs(cached_parts(p)) do
			local sp, onscreen = worldtoviewportpoint(camera, part.Position)
			if onscreen then
				local dx = sp.X - mx
				local dy = sp.Y - my
				local d2 = dx * dx + dy * dy
				if d2 < best_d2 then
					best_part = part
					best_d2 = d2
					best_x, best_y = sp.X, sp.Y
				end
			end
		end
	end

	if not best_part or best_d2 > radius * radius then
		return
	end

	if mousemoverel_fn then
		move_mouse_to_point(best_x, best_y, mx, my, aimbot.smoothness)
	end
end

-- triggerbot
local tb_state = {
	active = false,
	exit_deadline = 0,
	last_click = 0,
}

local function activate_tool()
	local tool = held_tool
	if tool then
		tool:Activate()
	end
end

-- render target shared between run_frame (sets) and render_frame (draws)
local render_target = nil

-- cheap per-heartbeat trigger test: mouse-in-rect against cached hitbox
-- rects (no raycasts, no projections, no allocations). shot decision stays
-- at 240Hz even though rects refresh at scan rate.

-- pick the closest enemy whose scan rect is under the crosshair and within
-- the given gun's range. returns the best player (or nil). honors whatever
-- the scan baked in (k.o, LOS) since scan_ok excludes those.
-- optional fov_radius (pixels): when provided, only targets whose root
-- projects inside the circle around the mouse are eligible. the plain
-- triggerbot calls without it (whole screen); the gun-macro passes its
-- fov.radius so it only swaps/shoots inside the circle.
local function triggerbot_target(gun_cfg, fov_radius)
	local gun_distance = gun_cfg and gun_cfg.range
	if gun_distance == nil then
		return nil
	end
	local best, best_d2 = nil, huge
	local cam_pos = range_origin()
	local team_check = cfg().triggerbot.checks.team ~= false
	local fov2 = fov_radius and fov_radius * fov_radius
	for _, p in cached_players do
		if p == client or not target_allowed(p, team_check) then
			continue
		end
		local st = player_state[p]
		if st and st.scan_ok then
			local hrp = refs_for(p).hrp
			local delta = hrp and (hrp.Position - cam_pos)
			if delta and delta:Dot(delta) <= gun_distance * gun_distance then
				local r = st.rect
				if mouse_x >= r.minx and mouse_x <= r.maxx and mouse_y >= r.miny and mouse_y <= r.maxy then
					local pos = worldtoviewportpoint(camera, hrp.Position)
					local dx = pos.X - mouse_x
					local dy = pos.Y - mouse_y
					local d2 = dx * dx + dy * dy
					if fov2 and d2 > fov2 then
						continue
					end
					if d2 < best_d2 then
						best = p
						best_d2 = d2
					end
				end
			end
		end
	end
	return best
end

-- self crouch check: LeftControl/RightControl held = crouching. matches
-- the game's crouch input (shift-lock-style movement) so the script
-- never fires while the player is crouched.
local function self_crouched()
	return crouch_held
end

local function trigger_fast_check()
	local triggerbot = cfg().triggerbot

	if not triggerbot.enabled then
		tb_state.active = false
		render_target = nil
		return
	end

	local gun_cfg, is_knife = equipped_tool_state(triggerbot)
	local gun_distance = gun_cfg and gun_cfg.range

	-- gun switch detected (distance or tool changed): the cached scan
	-- rects were built for the old gun's range, so invalidate and force a
	-- rescan on the next heartbeat instead of shooting stale ranges
	if gun_distance ~= last_gun_distance then
		last_gun_distance = gun_distance
		invalidate_scan()
	end

	if gun_distance == nil then
		tb_state.active = false
		render_target = nil
		return
	end
	if triggerbot.checks.knife and is_knife then
		tb_state.active = false
		render_target = nil
		return
	end
	if triggerbot.checks.ko and is_ko(client) then
		tb_state.active = false
		render_target = nil
		return
	end
	if triggerbot.checks.crouched ~= false and self_crouched() then
		tb_state.active = false
		render_target = nil
		return
	end
	if not is_trigger_active() then
		tb_state.active = false
		render_target = nil
		return
	end

	local best = triggerbot_target(gun_cfg)
	render_target = best
	local over_any = best ~= nil

	local now = clock()
	if over_any then
		if not tb_state.active then
			tb_state.last_click = 0
		end
		tb_state.active = true
		-- per-gun exit-buffer, falls back to the triggerbot timing section
		local timing = triggerbot.timing or {}
		local exit_buffer = gun_cfg and gun_cfg.exit_buffer
		if not (type(exit_buffer) == "number" and exit_buffer > 0) then
			exit_buffer = tonumber(timing.exit_buffer) or 0.14
		end
		-- movement-aware: a fast target OR fast own movement leaves the
		-- crosshair box between scans (relative motion), so extend the exit
		-- window in proportion to the combined speed (capped). keeps the
		-- trigger locked on sprinters and while we're moving without making
		-- stationary targets linger. the extension per stud/s is
		-- configurable (timing.speed_factor).
		local speed_factor = tonumber(timing.speed_factor) or 0.0025
		local speed_bonus = clamp((root_speed(best) + root_speed(client)) * speed_factor, 0, 0.3)
		tb_state.exit_deadline = now + exit_buffer + speed_bonus
	elseif not (tb_state.active and now < tb_state.exit_deadline) then
		tb_state.active = false
	end

	local click_interval = tonumber(triggerbot.timing and triggerbot.timing.click_interval) or 0.015
	if tb_state.active and now - tb_state.last_click >= click_interval then
		activate_tool()
		tb_state.last_click = now
	end
end

